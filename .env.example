APP_NAME="Bestlink FMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Section 59: never commit real credentials. Copy this file to .env and
# fill in your local XAMPP MySQL details -- an empty DB_PASSWORD matches a
# fresh XAMPP install's default "root" account with no password, but set a
# real one before this ever leaves your machine.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fms_database
DB_USERNAME=root
DB_PASSWORD=

# Database-backed sessions (see the sessions migration) so an
# Administrator disabling a user invalidates that user's active session
# immediately -- see App\Http\Middleware\EnsureAccountActive.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Set true once the app is served over HTTPS in production.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# Section 68: password shared by every seeded demo account
# (admin@example.test, accountant@example.test, collegeadmin@example.test,
# employee@example.test). Change this before deploying anywhere other
# people can reach, and never reuse it for a real account.
DEMO_USER_PASSWORD=Str0ngDemoPass!

# Mail is required for the password-reset flow (Section 36) to actually
# deliver a link. `log` writes reset emails to storage/logs/laravel.log,
# which is fine for local development -- switch to a real SMTP/API driver
# before production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="fms@bestlink.test"
MAIL_FROM_NAME="${APP_NAME}"
